---
const contentOne = [
  {
    title: "Pure Play",
    description:
      "DerivaConnect is the only investment platform offering undiluted, direct exposure to Venezuelan oil exploration and production — no mixed funds, no diversified portfolios.",
  },
  {
    title: "Contractually Secured",
    description:
      "Every investment is backed by long-term exploration and production contracts, providing legally secured, predictable revenue streams for our partners.",
  },
  {
    title: "Integrated Operations",
    description:
      "Our fully integrated oil field services division manages every stage of production on the ground in Venezuela, ensuring operational targets are consistently delivered.",
  },
  {
    title: "Investor Retention",
    description:
      "Our transparency, rigorous due diligence, and consistent performance have resulted in over 99% of investment partners renewing their commitment year over year.",
  },
];
const knowus = [
  {
    title: "Our Mission",
    description:
      "DerivaConnect's mission is to provide institutional investors, accredited individuals, and oil field services partners with the most transparent, secure, and direct access to Venezuelan oil and gas assets available anywhere in the world.",
  },
  {
    title: "Our Values",
    description:
      "We operate with absolute integrity, rigorous legal compliance, and full transparency. Our investors deserve to know exactly what their capital is doing — and we deliver that clarity at every stage of the investment lifecycle.",
  },
  {
    title: "Our Advantage",
    description:
      "Venezuela holds the world's largest proven oil reserves. As the only pure play platform with contractually secured exploration and production rights, DerivaConnect offers an investment opportunity found nowhere else.",
  },
];
const team = [
  {
    image: "/avatar1.png",
    name: "LEADERSHIP TEAM",
    position: "MANAGEMENT",
    personality:
      "DerivaConnect is led by a team of experienced energy investment professionals, legal specialists, and on-the-ground operations managers with decades of combined experience in Latin American oil and gas markets.",
  },
  {
    image: "/avatar2.png",
    name: "LEGAL & COMPLIANCE",
    position: "REGULATORY",
    personality:
      "Our legal team ensures all exploration and production contracts meet Venezuelan regulatory requirements and international investment standards, providing our partners with the compliance certainty they need.",
  },
  {
    image: "/avatar5.png",
    name: "FIELD OPERATIONS",
    position: "OIL FIELD SERVICES",
    personality:
      "Our fully integrated oil field services providers manage all on-the-ground operations in Venezuela — from initial exploration and drilling through to ongoing production maintenance and optimization.",
  },
];
---

<section class="overflow-hidden border-b">
  <div class="max-w-screen-xl px-8 pt-24 mx-auto md:px-12 lg:px-32">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div>
        <span
          class="font-mono text-xs font-medium tracking-tight text-blue-600 uppercase"
        >
          About
        </span>
        <h1
          class="mt-8 text-4xl font-semibold tracking-tighter text-blue-950 md:text-6xl"
        >
          Venezuela: <span
            class="md:text-transparent md:bg-clip-text md:bg-gradient-to-r from-blue-500 to-indigo-600 py-2"
            >#1 Pure Play Oil &amp; Gas Platform Investment</span
          >
        </h1>
        <p class="mt-4 text-base text-gray-700 lg:text-base">
          DerivaConnect was founded with a single conviction: Venezuela's oil and gas resources represent one of the most compelling investment opportunities in the world — and no one was making it truly accessible.
          <br />
          <br />
          We hold contractually secured agreements to conduct oil exploration and production in Venezuela. Combined with our fully integrated oil field services operations, we offer institutional investors, accredited individuals, and partner companies direct, transparent, and legally secured exposure to Venezuelan oil and gas assets.
        </p>
      </div>
    </div>
  </div>
</section>
<section>
  <div class="max-w-screen-xl px-8 pt-24 mx-auto md:px-12 lg:px-32">
    <div
      class="grid items-start grid-cols-1 gap-12 md:grid-cols-2 xl:grid-cols-4"
    >
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 xl:grid-cols-1">
        {
          contentOne.map((content) => (
            <>
              <div>
                <p class="font-mono text-base font-medium tracking-tighter uppercase text-blue-950">
                  {content.title}
                </p>
                <p class="mt-2 text-sm text-gray-700">{content.description}</p>
              </div>
            </>
          ))
        }
      </div>
      <dl
        class="grid grid-cols-1 gap-12 text-center lg:ml-auto sm:grid-cols-2 md:grid-cols-2 lg:grid-cols-4 xl:col-span-3"
      >
        <div
          x-data="{ count: 0, target: 30, counter() { let interval = setInterval(() => { if (this.count < this.target) { this.count += 1; } else { clearInterval(interval); } }, 50); } }"
          x-intersect.once="counter()"
          class="flex flex-col"
        >
          <dt
            class="mt-4 font-mono text-sm font-medium tracking-tighter uppercase text-blue-950"
          >
            Partner Retention
          </dt>
          <dd
            x-text="`${count}%`"
            class="order-first font-mono text-3xl font-semibold tracking-tight text-blue-700"
          >
          </dd>
        </div>
        <div
          x-data="{ count: 0, target: 40, counter() { let interval = setInterval(() => { if (this.count < this.target) { this.count += 1; } else { clearInterval(interval); } }, 50); } }"
          x-intersect.once="counter()"
          class="flex flex-col"
        >
          <dt
            class="mt-4 font-mono text-sm font-medium tracking-tighter uppercase text-blue-950"
          >
            Contractually Secured
          </dt>
          <dd
            x-text="`${count}%`"
            class="order-first font-mono text-3xl font-semibold tracking-tight text-blue-700"
          >
          </dd>
        </div>
        <div
          x-data="{ count: 0, target: 50, counter() { let interval = setInterval(() => { if (this.count < this.target) { this.count += 1; } else { clearInterval(interval); } }, 50); } }"
          x-intersect.once="counter()"
          class="flex flex-col"
        >
          <dt
            class="mt-4 font-mono text-sm font-medium tracking-tighter uppercase text-blue-950"
          >
            Pure Play Exposure
          </dt>
          <dd
            x-text="`${count}%`"
            class="order-first font-mono text-3xl font-semibold tracking-tight text-blue-700"
          >
          </dd>
        </div>
        <div
          x-data="{ count: 0, target: 60000000, counter() { let interval = setInterval(() => { if (this.count < this.target) { this.count += 1000000; } else { clearInterval(interval); this.count = this.target; } }, 50); } }"
          x-intersect.once="counter()"
          class="flex flex-col"
        >
          <dt
            class="mt-4 font-mono text-sm font-medium tracking-tighter uppercase text-blue-950"
          >
            Proven Reserves (Barrels)
          </dt>
          <dd
            x-text="`${(count / 1000000) % 1 === 0 ? (count / 1000000) : (count / 1000000).toFixed(1)}M`"
            class="order-first font-mono text-3xl font-semibold tracking-tight text-blue-700"
          >
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
<section class="overflow-hidden">
  <div class="relative max-w-screen-xl px-8 pt-24 mx-auto md:px-12 lg:px-32">
    <div class="flex flex-col gap-12">
      <div>
        <span
          class="font-mono text-xs font-medium tracking-tight text-blue-600 uppercase"
        >
          Get to know us
        </span>
        <p class="mt-8 text-4xl font-semibold tracking-tighter text-blue-950">
          Our commitment to <span
            class="md:block md:text-transparent md:bg-clip-text md:bg-gradient-to-r from-blue-500 to-indigo-600 py-2"
            >transparency and results
          </span>
        </p>
        <p class="max-w-sm mt-4 text-base text-gray-700 lg:text-base">
          Everything we do is grounded in legal certainty, operational discipline, and investor trust.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-12 mx-auto mt-8 lg:grid-cols-3">
        {
          knowus.map((content) => (
            <>
              <div>
                <p class="font-mono text-base font-medium tracking-tighter uppercase text-blue-950">
                  {content.title}
                </p>
                <p class="mt-2 text-sm text-gray-700">{content.description}</p>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
<section>
  <div class="relative max-w-screen-xl px-8 pt-24 mx-auto md:px-12 lg:px-32">
    <div class="flex flex-col gap-12">
      <div>
        <span
          class="font-mono text-xs font-medium tracking-tight text-blue-600 uppercase"
        >
          Team
        </span>
        <p class="mt-8 text-4xl font-semibold tracking-tighter text-blue-950">
          Our team
        </p>
        <p class="max-w-sm mt-4 text-base text-gray-700 lg:text-base">
          Meet the people behind DerivaConnect's exploration, legal, and field operations.
        </p>
      </div>
      <div class="relative grid gap-12 mt-12 sm:grid-cols-2 xl:grid-cols-3">
        {
          team.map((team) => (
            <>
              <div class="flex flex-col justify-between h-full">
                <div>
                  <span class="font-mono text-xs font-medium tracking-tight text-blue-600 uppercase">
                    {team.position}
                  </span>
                  <p class="mt-8 font-mono text-base font-medium tracking-tighter uppercase">
                    {team.name}
                  </p>
                  <img
                    src={team.image}
                    class="order-last mt-8 rounded-2xl shadow-box shadow-gray-500/50 aspect-[4/4] object-cover"
                    alt={team.name}
                  />
                  <div class="mt-8 text-sm text-gray-700">
                    {team.personality}
                  </div>
                </div>
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</section>
<section>
  <div class="max-w-screen-xl px-8 py-24 mx-auto lg:py-32 md:px-12 lg:px-32">
    <div class="flex flex-col w-full gap-12 text-center">
      <div>
        <p
          class="text-4xl font-semibold tracking-tighter text-blue-950 md:text-6xl"
        >
          Ready to invest in Venezuela's oil and gas future?
        </p>
        <p class="max-w-sm mx-auto mt-4 text-gray-700">
          Express your interest and a member of our team will be in touch to discuss how DerivaConnect can work for you.
        </p>
      </div>
      <div class="flex justify-center">
        <a
          href="/forms/contact"
          class="flex items-center justify-center h-10 px-4 py-2 text-sm font-semibold text-white transition-all duration-200 rounded-full bg-gradient-to-b from-blue-500 to-indigo-600 hover:to-indigo-700 shadow-button shadow-blue-600/50 focus:ring-2 focus:ring-blue-950 focus:ring-offset-2 ring-offset-gray-200 hover:shadow-none"
        >
          Express Interest
        </a>
      </div>
    </div>
  </div>
</section>
