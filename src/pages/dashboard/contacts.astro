---
import { supabaseAdmin } from "@/lib/supabase";

const { data: contacts, error } = await supabaseAdmin
  .from("contacts")
  .select("*")
  .order("created_at", { ascending: false });
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>CRM Contacts — DerivaConnect</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-gray-100 min-h-screen">
    <div class="max-w-screen-xl mx-auto px-8 py-12 md:px-12 lg:px-32">
      <div class="flex items-center justify-between mb-8">
        <h1 class="text-2xl font-semibold tracking-tighter text-blue-950">
          CRM Contacts
        </h1>
        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="flex items-center justify-center h-8 px-4 py-2 text-xs font-semibold text-white duration-200 rounded-full bg-gradient-to-b from-blue-500 to-blue-600 hover:to-blue-700 shadow-button shadow-blue-600/50 focus:ring-2 focus:ring-blue-950 focus:ring-offset-2 ring-offset-gray-200 hover:shadow-none"
          >
            Sign out
          </button>
        </form>
      </div>

      {error && (
        <div class="p-4 mb-6 rounded-lg bg-red-50 text-red-700 text-sm">
          Failed to load contacts: {error.message}
        </div>
      )}

      {contacts && contacts.length === 0 && (
        <div class="p-8 text-center text-gray-500 text-sm bg-white rounded-2xl">
          No contacts yet.
        </div>
      )}

      {contacts && contacts.length > 0 && (
        <div class="overflow-hidden rounded-2xl shadow-box shadow-gray-500/10 bg-white">
          <table class="min-w-full divide-y divide-gray-200 text-sm">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Email</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Company</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Date</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              {contacts.map((contact: any) => (
                <tr class="hover:bg-gray-50 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-blue-950 font-medium">
                    {contact.first_name} {contact.last_name}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600">
                    {contact.email}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-600">
                    {contact.company ?? "—"}
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700 capitalize">
                      {contact.status ?? "lead"}
                    </span>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500 text-xs">
                    {new Date(contact.created_at).toLocaleDateString()}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  </body>
</html>
